# Copia in .env e compila. Non committare .env.
ANTHROPIC_API_KEY=sk-ant-...
JWT_SECRET=stringa-lunga-casuale

# Primo admin: creato al primo avvio se la tabella users è vuota.
ADMIN_USERNAME=spit
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Autenticazione: local (default) oppure gateway (dietro Borant ID).
# In gateway l'app si fida di X-Borant-* SOLO se la richiesta arriva da
# BORANT_TRUSTED_PROXY, che sotto docker e' il gateway del bridge e non
# 127.0.0.1: si legge dal log dell'app dopo una richiesta vera, non si deduce.
# AUTH_MODE=local
# BORANT_TRUSTED_PROXY=127.0.0.1
# BORANT_LOGOUT_URL=https://id.borant.eu/logout

# Opzionali
# GR_MODEL=claude-opus-5
# GR_SCHEDULER=1        # 0 per disattivare cron interni (dev)
# GR_DB=/data/grantradar.db
